# ==========================================
# 1. ENVIRONMENT & SECRETS (CRITICAL)
# ==========================================
.env
.env.local
.env.production
.env.*.local
*.pem
google-credentials.json
service-account.json
# Any file containing API keys, passwords, or database URLs

# ==========================================
# 2. VIRTUAL ENVIRONMENTS
# ==========================================
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ==========================================
# 3. PYTHON COMPILED & CACHE FILES
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 4. DJANGO SPECIFIC
# ==========================================
# Local development database (Production uses PostgreSQL)
*.sqlite3
*.sqlite3-journal

# Collected static files (generated by `collectstatic`)
staticfiles/
static_root/

# User-uploaded media files (QR codes, logos, etc.)
media/
# Note: If you have default static assets (like a base CSS file), 
# keep them in an `app_name/static/` folder, which is NOT ignored.

